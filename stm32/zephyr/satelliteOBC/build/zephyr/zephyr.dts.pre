# 1 "/gsFiles/Projects/stm32/zephyr/satelliteOBC/zephyr/include/zephyr/dt-bindings/input/input-event-codes.h" 1 3 4
# 13 "/gsFiles/Projects/stm32/zephyr/satelliteOBC/zephyr/boards/st/nucleo_f303re/nucleo_f303re.dts" 2

/ {
 model = "STMicroelectronics STM32F303RE-NUCLEO board";
 compatible = "st,stm32f303re-nucleo";

 chosen {
  zephyr,console = &usart2;
  zephyr,shell-uart = &usart2;
  zephyr,sram = &sram0;
  zephyr,flash = &flash0;
  zephyr,canbus = &can1;
 };

 leds: leds {
  compatible = "gpio-leds";

  green_led_2: led_2 {
   gpios = <&gpioa 5 (0 << 0)>;
   label = "User LD2";
  };
 };

 gpio_keys {
  compatible = "gpio-keys";

  user_button: button {
   label = "User";
   gpios = <&gpioc 13 (1 << 0)>;
   zephyr,code = <11>;
  };
 };

 aliases {
  led0 = &green_led_2;
  sw0 = &user_button;
 };
};

&clk_lsi {
 status = "okay";
};

&clk_hse {
 hse-bypass;
 clock-frequency = <(((8) * 1000) * 1000)>;
 status = "okay";
};

&pll {
 prediv = <1>;
 mul = <9>;
 clocks = <&clk_hse>;
 status = "okay";
};

&rcc {
 clocks = <&pll>;
 clock-frequency = <(((72) * 1000) * 1000)>;
 ahb-prescaler = <1>;
 apb1-prescaler = <2>;
 apb2-prescaler = <1>;
};

&usart2 {
 pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
 pinctrl-names = "default";
 current-speed = <115200>;
 status = "okay";
};

&usart1 {
 pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
 pinctrl-names = "default";
 current-speed = <115200>;
 status = "okay";
};

&rtc {
 clocks = <&rcc (0x01c) (1 << 28)>,
   <&rcc 0x003 ((((0x20) & 0xFFFFU) << 0U) | (((8) & 0x1FU) << 16U) | ((((9) - (8)) & 0x3U) << 21U) | ((((2)) & 0xFFU) << 24U))>;
 status = "okay";
};

&can1 {
 pinctrl-0 = <&can_rx_pb8 &can_tx_pb9>;
 pinctrl-names = "default";
 status = "okay";
};

&i2c1 {
 pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
 status = "okay";
 pinctrl-names = "default";
 clock-frequency = <100000>;
 scl-gpios = <&gpiob 8 (0 << 0)>;
 sda-gpios = <&gpiob 9 (0 << 0)>;
};

&spi1 {
 pinctrl-0 = <&spi1_mosi_pa7 &spi1_miso_pa6 &spi1_sck_pa5>;
 pinctrl-names = "default";
 status = "okay";
};
# 0 "<command-line>" 2
# 1 "/gsFiles/Projects/stm32/zephyr/satelliteOBC/nucleo_f303re.overlay" 1
&spi1 {
 pinctrl-0 = <&spi1_mosi_pa7 &spi1_miso_pa6 &spi1_sck_pa5>;
    pinctrl-names = "default";
    cs-gpios = <&gpiob 6 (0 << 0)>;
    status = "okay";
};
